# Copy to .env and adjust values as needed.
# All variables use the IAP_ prefix (Image Ambiguity Prediction).

IAP_APP_ENV=development
IAP_DEBUG=true
IAP_LOG_LEVEL=INFO
IAP_RANDOM_SEED=42

IAP_ANNOTATION_FILE=dataset/annotations/captions_val2017.json
IAP_IMAGE_DIR=dataset/val2017
IAP_MODELS_DIR=models
IAP_RESULTS_DIR=results
IAP_LOG_DIR=results/logs
IAP_EMBEDDINGS_DIR=results/embeddings

IAP_EXPERIMENT_NAME=image_ambiguity_baseline
IAP_SAMPLE_SIZE=500
IAP_TRAIN_RATIO=0.7
IAP_VAL_RATIO=0.15
IAP_TEST_RATIO=0.15

IAP_API_HOST=127.0.0.1
IAP_API_PORT=8000
IAP_API_RELOAD=true

IAP_SENTENCE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
IAP_DEVICE=auto
IAP_EMBEDDING_BATCH_SIZE=32
